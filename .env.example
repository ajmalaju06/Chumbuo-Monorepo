# Public site origin, used for auth email links and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (local values come from `pnpm supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Never prefix with NEXT_PUBLIC_ and never import from client code.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Salt for hashing visitor IPs/emails (rate limits, spam checks). Any long random string.
HASH_SALT=change-me-to-a-long-random-string
